---
import logo from "../../../public/brand/logo-lockup.png";
import { Image } from "astro:assets";

const links = [
	{ label: "Experiencias", href: "/#experiencias" },
	{ label: "Nosotros", href: "/nosotros" },
	{ label: "Galeria", href: "/galeria" },
	{ label: "FAQ", href: "/faq" },
];
---

<header class="nav" data-nav>
	<a href="/" class="nav__logo">
		<Image src={logo} alt="Cabalgatas Cuatro Tiempos" width={135} height={45} />
	</a>
	<nav class="nav__links" aria-label="Principal">
		{links.map((link) => (
			<a href={link.href}>{link.label}</a>
		))}
	</nav>
	<a href="/#experiencias" class="button button--secondary nav__cta">
		RESERVAR →
	</a>
</header>

<script>
	function initNav(nav: HTMLElement) {
		const hero = document.querySelector<HTMLElement>("[data-hero]");

		if (!hero) {
			nav.classList.add("nav--solid");
			return;
		}

		function update() {
			const threshold = hero!.offsetHeight - nav.offsetHeight;
			nav.classList.toggle("nav--solid", window.scrollY > threshold);
		}

		update();
		window.addEventListener("scroll", update, { passive: true });
	}

	document.querySelectorAll<HTMLElement>("[data-nav]").forEach(initNav);
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1rem var(--gutter);
		background: transparent;
		transition:
			background 300ms var(--ease-calm),
			backdrop-filter 300ms var(--ease-calm);
	}

	.nav--solid {
		background: rgba(20, 15, 11, 0.55);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.nav__logo :global(img) {
		display: block;
		height: 2.5rem;
		width: auto;
	}

	.nav__links {
		display: none;
		align-items: center;
		gap: 2.5rem;
		font-size: var(--text-body);
		color: var(--color-text-image);
	}

	.nav__links a {
		text-decoration: none;
	}

	.nav__cta {
		border-color: var(--color-brown);
		color: var(--color-text-image);
		text-transform: none;
		letter-spacing: 0.07em;
		padding: 0.625rem 1.25rem;
		font-size: var(--text-small);
	}

	@media (min-width: 1024px) {
		.nav__links {
			display: flex;
		}
	}
</style>
