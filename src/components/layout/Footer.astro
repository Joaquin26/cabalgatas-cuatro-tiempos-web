---
import { whatsappUrl, instagramUrl, tiktokUrl, email, phone } from "../../data/contact";
import WhatsAppIcon from "../ui/WhatsAppIcon.astro";
import logo from "../../../public/brand/logo-lockup.png";
import { Image } from "astro:assets";

const year = new Date().getFullYear();

const experienceLinks = [
	{ label: "Full Day a Caballo", href: "/experiencias/full-day" },
	{ label: "Cabalgata por el Valle", href: "/#experiencias" },
	{ label: "Pilates & Horses", href: "/#experiencias" },
	{ label: "Experiencias privadas", href: "/#celebra" },
];

const infoLinks = [
	{ label: "Nosotros", href: "/nosotros" },
	{ label: "Galería", href: "/galeria" },
	{ label: "FAQ", href: "/faq" },
];

const legalLinks = [
	{ label: "Políticas de reserva", href: "/politicas-de-reserva" },
	{ label: "Términos y condiciones", href: "/terminos-y-condiciones" },
	{ label: "Política de privacidad", href: "/politica-de-privacidad" },
];

const socialLinks = [
	{ label: "Instagram", href: instagramUrl },
	{ label: "TikTok", href: tiktokUrl },
	{ label: "WhatsApp", href: whatsappUrl },
];
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__brand">
			<a href="/" class="footer__logo">
				<Image src={logo} alt="Cabalgatas Cuatro Tiempos" width={150} height={50} />
			</a>
			<p class="footer__tagline">
				Experiencias a caballo en el corazón de Pachacámac, donde la naturaleza, el bienestar y la
				conexión se viven de verdad.
			</p>
			<div class="footer__social">
				{socialLinks.map((link) => (
					<a
						href={link.href}
						class="footer__social-link"
						target="_blank"
						rel="noopener noreferrer"
						aria-label={link.label}
					>
						{link.label === "Instagram" && (
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
							>
								<rect x="3" y="3" width="18" height="18" rx="5" />
								<circle cx="12" cy="12" r="4" />
								<circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
							</svg>
						)}
						{link.label === "TikTok" && (
							<svg
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
							>
								<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5" />
								<path d="M14 3c.4 2.4 2 4 4.5 4.2" />
							</svg>
						)}
						{link.label === "WhatsApp" && <WhatsAppIcon size={18} />}
					</a>
				))}
			</div>
		</div>

		<nav class="footer__col" aria-labelledby="footer-experiencias">
			<p class="footer__heading" id="footer-experiencias">
				Experiencias
			</p>
			{experienceLinks.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>

		<nav class="footer__col" aria-labelledby="footer-info">
			<p class="footer__heading" id="footer-info">
				Información
			</p>
			{infoLinks.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>

		<div class="footer__col">
			<p class="footer__heading">Contacto</p>
			<p class="footer__contact">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<path d="M12 21s7-6.2 7-11.5a7 7 0 1 0-14 0C5 14.8 12 21 12 21z" />
					<circle cx="12" cy="9.5" r="2.5" />
				</svg>
				Pachacámac, Lima, Perú
			</p>
			<a href={whatsappUrl} class="footer__contact" target="_blank" rel="noopener noreferrer">
				<WhatsAppIcon size={20} />
				{phone}
			</a>
			<a href={`mailto:${email}`} class="footer__contact">
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					aria-hidden="true"
				>
					<rect x="3" y="5" width="18" height="14" rx="2" />
					<path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
				</svg>
				{email}
			</a>
		</div>
	</div>

	<div class="footer__bottom">
		<p>© {year} Cabalgatas Cuatro Tiempos. Todos los derechos reservados.</p>
		<ul class="footer__legal">
			{legalLinks.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))}
			<li>
				<a href="https://oneraincode.com" target="_blank" rel="noopener noreferrer">
					Desarrollado por OneRainCode
				</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-dark-chocolate);
		color: var(--color-text-image);
		padding: 3.5rem var(--gutter) 2rem;
	}

	.footer__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		max-width: var(--max-width);
		margin-inline: auto;
	}

	.footer__brand {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.footer__logo :global(img) {
		display: block;
		height: 3rem;
		width: auto;
	}

	.footer__tagline {
		font-size: var(--text-small);
		line-height: 1.6;
		color: var(--color-dark-sand);
		max-width: 22rem;
	}

	.footer__social {
		display: flex;
		gap: 0.75rem;
	}

	.footer__social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid var(--color-brown);
		color: var(--color-dark-sand);
		transition:
			border-color var(--duration-fast) var(--ease-calm),
			color var(--duration-fast) var(--ease-calm),
			background-color var(--duration-fast) var(--ease-calm),
			transform var(--duration-fast) var(--ease-calm);
	}

	.footer__social-link:hover {
		border-color: var(--color-dark-sand);
		background: color-mix(in srgb, var(--color-text-image) 8%, transparent);
		color: var(--color-text-image);
		transform: translateY(-2px);
	}

	.footer__social-link svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.footer__col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.footer__heading {
		font-family: var(--font-display);
		font-size: var(--text-h4);
		font-weight: 400;
		color: var(--color-text-image);
		margin-bottom: 0.5rem;
	}

	.footer__col a,
	.footer__contact {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: var(--text-small);
		color: var(--color-dark-sand);
		text-decoration: none;
	}

	.footer__col a {
		background: linear-gradient(currentColor, currentColor) 0 calc(50% + 0.7rem) / 0 1px no-repeat;
		transition:
			color var(--duration-fast) var(--ease-calm),
			background-size var(--duration-fast) var(--ease-calm);
	}

	.footer__col a:hover,
	.footer__col a:focus-visible {
		color: var(--color-text-image);
		background-size: 100% 1px;
	}

	.footer__contact {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
	}

	/* :global because the WhatsApp icon is a child component, outside this file's scoped styles. */
	.footer__contact :global(svg) {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		max-width: 1.25rem;
		color: var(--color-camel);
	}

	.footer__bottom {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: var(--max-width);
		margin: 2.5rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(247, 241, 233, 0.12);
		font-size: var(--text-eyebrow);
		color: var(--color-dark-sand);
	}

	.footer__bottom p {
		margin: 0;
	}

	.footer__legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (min-width: 768px) {
		.footer__legal {
			gap: 0.5rem 0;
		}

		.footer__legal li + li::before {
			content: "|";
			margin-inline: 1rem;
			color: var(--color-brown);
		}
	}

	.footer__legal a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: inherit;
		text-decoration: none;
	}

	.footer__legal a:hover {
		color: var(--color-text-image);
	}

	@media (min-width: 640px) {
		.footer__inner {
			grid-template-columns: repeat(2, 1fr);
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}

	@media (min-width: 1024px) {
		.footer__inner {
			grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
			gap: 3rem;
		}

		.footer__brand {
			grid-column: auto;
		}

		.footer__col {
			padding-left: 2.5rem;
			border-left: 1px solid rgba(247, 241, 233, 0.12);
		}

		.footer__bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
</style>
