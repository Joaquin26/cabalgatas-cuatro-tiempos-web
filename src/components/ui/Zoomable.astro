---
// Makes a single photo open in the viewer (Lightbox). Wrap the <Image> in it; the photo is its own
// one-item group, so it never mixes with other photos on the page.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	/** Set when the photo belongs to a bigger group: the parent holds data-lightbox-group. */
	grouped?: boolean;
	/** Position inside that group, for previous/next. */
	order?: number;
}

const { src, alt, grouped = false, order = 0 } = Astro.props;
const full = (await getImage({ src, width: 1600 })).src;
---

<span class="zoomable" data-lightbox-group={grouped ? undefined : ""}>
	<button
		type="button"
		data-lightbox-open
		data-order={order}
		data-full={full}
		data-alt={alt}
		aria-label={`Ampliar foto: ${alt}`}
	>
		<slot />
	</button>
</span>

<style>
	.zoomable,
	.zoomable button {
		display: block;
		width: 100%;
		height: 100%;
	}

	.zoomable button {
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.zoomable button:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: -4px;
	}
</style>
