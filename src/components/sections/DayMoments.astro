---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import Zoomable from "../ui/Zoomable.astro";
import arrive from "../../assets/galeria/fotos/porton.jpg";
import meet from "../../assets/galeria/fotos/clase-guia.jpg";
import valley from "../../assets/galeria/fotos/ruta-quebrada.jpg";
import table from "../../assets/galeria/fotos/almuerzo-mesa.jpg";
import fire from "../../assets/galeria/fotos/fogata-amigos.jpg";

const steps = [
	{
		number: "01",
		label: "Llegas al campo",
		image: arrive,
		alt: "Portón de entrada al rancho cubierto de buganvillas",
	},
	{
		number: "02",
		label: "Conoces a tu caballo",
		image: meet,
		alt: "Guía preparando a los jinetes en el picadero antes de salir",
	},
	{
		number: "03",
		label: "Conoces el valle",
		image: valley,
		alt: "Fila de jinetes avanzando por la quebrada",
	},
	{
		number: "04",
		label: "Compartes la mesa",
		image: table,
		alt: "Mesa campestre servida con platos caseros",
	},
	{
		number: "05",
		label: "Terminas sin prisa",
		image: fire,
		alt: "Amigos tostando malvaviscos alrededor de la fogata",
	},
];
---

<section class="day-moments section">
	<SectionHeader
		eyebrow="ASÍ SE VIVE CUATRO TIEMPOS"
		title="Un día, muchos momentos"
		align="center"
		class="reveal"
	/>
	<ol class="day-moments__list" data-stagger data-lightbox-group>
		{steps.map((step, i) => (
			<li class="day-moments__step">
				<span class="day-moments__image">
					<Zoomable src={step.image} alt={step.alt} grouped order={i}>
						<Image src={step.image} alt="" width={480} height={548} />
					</Zoomable>
				</span>
				<span class="day-moments__text">
					<span class="day-moments__number">{step.number}</span>
					<span class="day-moments__label">{step.label}</span>
				</span>
			</li>
		))}
	</ol>
</section>

<style>
	.day-moments {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-header-gap);
		text-align: center;
	}

	.day-moments__list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-grid-gap);
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.day-moments__step {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		text-align: left;
	}

	.day-moments__image {
		display: block;
		width: 100%;
		aspect-ratio: var(--ratio-photo-tall);
		overflow: hidden;
		position: relative;
	}

	.day-moments__image::after {
		content: "";
		position: absolute;
		inset: 0;
		/* The tint must not block clicks on the photo underneath. */
		pointer-events: none;
		background: rgba(98, 75, 56, 0.08);
	}

	.day-moments__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.day-moments__text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.day-moments__number {
		font-size: var(--text-eyebrow);
		letter-spacing: 0.1em;
		color: var(--color-brown);
	}

	.day-moments__label {
		font-family: var(--font-display);
		font-size: var(--text-card-title);
		color: var(--color-chocolate);
	}

	@media (min-width: 1024px) {
		.day-moments__list {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
