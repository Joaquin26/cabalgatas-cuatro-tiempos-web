---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../ui/SectionHeader.astro";
import LinkArrow from "../ui/LinkArrow.astro";
import Zoomable from "../ui/Zoomable.astro";
import photo1 from "../../assets/galeria/fotos/ruta-sendero.jpg";
import photo2 from "../../assets/galeria/fotos/caballo-saludo.jpg";
import photo3 from "../../assets/galeria/fotos/desayuno-tabla.jpg";
import photo4 from "../../assets/galeria/fotos/fogata-malvaviscos.jpg";
import photo5 from "../../assets/galeria/fotos/grupo-empresa.jpg";

interface Props {
	/** Photos for this page; without them the site-wide selection is shown. */
	photos?: { src: ImageMetadata; alt: string }[];
}

const defaultPhotos = [
	{ src: photo1, alt: "Jinetes recorriendo un sendero entre árboles, vistos desde otro caballo" },
	{ src: photo2, alt: "Mujer con sombrero sonriendo junto a dos caballos en el corral" },
	{ src: photo3, alt: "Tabla de desayuno con mermelada y queso, grabada con el logo de la marca" },
	{ src: photo4, alt: "Manos tostando malvaviscos sobre la fogata" },
	{ src: photo5, alt: "Grupo de una empresa posando frente a los caballos" },
];

const photos = Astro.props.photos?.length ? Astro.props.photos : defaultPhotos;
---

<section class="gallery-preview section">
	<div class="gallery-preview__header reveal">
		<SectionHeader eyebrow="GALERÍA" title="Momentos que hablan por sí solos" />
		<LinkArrow href="/galeria" label="VER GALERÍA →" />
	</div>
	<div class="gallery-preview__grid" data-stagger data-lightbox-group>
		{photos.map((photo, i) => (
			<div class="gallery-preview__tile">
				<Zoomable src={photo.src} alt={photo.alt} grouped order={i}>
					<Image
						src={photo.src}
						alt=""
						widths={[300, 600]}
						sizes="(min-width: 1024px) 20vw, 50vw"
					/>
				</Zoomable>
			</div>
		))}
	</div>
</section>

<style>
	.gallery-preview {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	.gallery-preview__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.gallery-preview__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-grid-gap);
	}

	.gallery-preview__tile {
		overflow: hidden;
		aspect-ratio: var(--ratio-photo-tall);
		background-color: var(--color-sand);
	}

	.gallery-preview__tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1024px) {
		.gallery-preview__grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
