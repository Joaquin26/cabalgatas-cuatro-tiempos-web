---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import LinkArrow from "../ui/LinkArrow.astro";
import Zoomable from "../ui/Zoomable.astro";
import photo1 from "../../assets/galeria/preview-1.jpg";
import photo2 from "../../assets/galeria/preview-2.jpg";
import photo3 from "../../assets/galeria/preview-3.jpg";
import photo4 from "../../assets/galeria/preview-4.jpg";
import photo5 from "../../assets/galeria/preview-5.jpg";

// The five photos were cut out of one contact sheet (tira.png); swap them for real, individual
// photos when they arrive. Alt texts describe each image.
const photos = [
	{ src: photo1, alt: "Jinete cabalgando por un sendero del valle, visto desde otro caballo" },
	{ src: photo2, alt: "Detalle de una montura de cuero con estribo" },
	{ src: photo3, alt: "Valle y montañas de Pachacámac" },
	{ src: photo4, alt: "Grupo reunido alrededor de una fogata al atardecer" },
	{ src: photo5, alt: "Mano acariciando el hocico de un caballo" },
];
---

<section class="gallery-preview section">
	<div class="gallery-preview__header reveal">
		<SectionHeader eyebrow="GALERÍA" title="Momentos que hablan por sí solos" />
		<LinkArrow href="/galeria" label="VER GALERÍA →" />
	</div>
	<div class="gallery-preview__grid" data-stagger data-lightbox-group>
		{photos.map((photo, i) => (
			<div class="gallery-preview__tile">
				<Zoomable src={photo.src} alt={photo.alt} grouped order={i}>
					<Image
						src={photo.src}
						alt=""
						widths={[300, 600]}
						sizes="(min-width: 1024px) 20vw, 50vw"
					/>
				</Zoomable>
			</div>
		))}
	</div>
</section>

<style>
	.gallery-preview {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	.gallery-preview__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.gallery-preview__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-grid-gap);
	}

	.gallery-preview__tile {
		overflow: hidden;
		aspect-ratio: var(--ratio-photo-tall);
		background-color: var(--color-sand);
	}

	.gallery-preview__tile :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 1024px) {
		.gallery-preview__grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
