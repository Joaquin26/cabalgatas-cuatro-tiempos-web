---
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	title: string;
	questions: { question: string; answer: string }[];
}

const { title, questions } = Astro.props;
---

<section class="section experience-faq">
	<SectionHeader title={title} class="reveal" />
	<div class="experience-faq__list reveal">
		{questions.map(({ question, answer }) => (
			<details class="faq-item">
				<summary>
					<span>{question}</span>
					<span class="faq-item__icon" aria-hidden="true">
						+
					</span>
				</summary>
				<p class="faq-item__answer">{answer}</p>
			</details>
		))}
	</div>
</section>

<style>
	.experience-faq {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	/* One readable column; the booking moment now lives in the closing band below. */
	.experience-faq__list {
		display: flex;
		flex-direction: column;
		max-width: 50rem;
	}

	.faq-item {
		border-bottom: 1px solid var(--color-sand);
	}

	.faq-item summary {
		padding-block: var(--space-sm);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		cursor: pointer;
		list-style: none;
		color: var(--color-chocolate);
		transition: color var(--duration-fast) var(--ease-calm);
	}

	.faq-item summary:hover {
		color: var(--color-brown);
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	.faq-item__icon {
		font-weight: var(--weight-semibold);
		font-size: var(--text-h4);
		color: var(--color-brown);
		transition: transform var(--duration-base) var(--ease-calm);
	}

	.faq-item[open] .faq-item__icon {
		transform: rotate(45deg);
	}

	.faq-item__answer {
		padding-bottom: var(--space-sm);
		line-height: 1.5;
		color: var(--color-brown);
	}
</style>
