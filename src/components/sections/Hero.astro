---
import { Image } from "astro:assets";
import heroImage from "../../assets/inicio/hero-cabalgata.jpg";

const slides = Array.from({ length: 5 }, () => ({
	image: heroImage,
	alt: "Grupo a caballo al atardecer en el valle de Pachacámac",
	heading: ["Vuelve a", "vivir lo esencial."],
	subtitle:
		"Experiencias entre caballos, naturaleza y momentos para recordar en el valle de Pachacámac.",
}));

const slideCount = String(slides.length).padStart(2, "0");
---

<section class="hero" data-hero data-slide-duration="15000">
	{slides.map((slide, i) => (
		<Image
			src={slide.image}
			alt={slide.alt}
			class:list={["hero__image", i === 0 && "is-active"]}
			data-hero-image={i}
			widths={[720, 1440, 2160]}
			sizes="100vw"
			loading={i === 0 ? "eager" : "lazy"}
			priority={i === 0}
		/>
	))}
	<div class="hero__scrim" aria-hidden="true"></div>
	<div class="hero__content">
		<div class="hero__text-stack">
			{slides.map((slide, i) => {
				// Only the first slide is the page's <h1>; the rest share its look as plain text.
				const Heading = i === 0 ? "h1" : "p";
				return (
					<div class:list={["hero__text", i === 0 && "is-active"]} data-hero-text={i}>
						<Heading class="hero__title reveal">
							{slide.heading.map((line, li) => (
								<>
									{line}
									{li < slide.heading.length - 1 && <br />}
								</>
							))}
						</Heading>
						<p class="hero__subtitle reveal">{slide.subtitle}</p>
					</div>
				);
			})}
		</div>
		<a href="/#experiencias" class="button button--secondary hero__cta reveal">
			DESCUBRIR EXPERIENCIAS →
		</a>
		<div class="hero__controls reveal">
			<button
				type="button"
				class="hero__slider"
				data-hero-pause
				aria-pressed="false"
				aria-label="Pausar carrusel"
				title="Pausar carrusel"
			>
				<span data-hero-counter>01/{slideCount}</span>
				<span class="hero__slider-track" aria-hidden="true">
					<span class="hero__slider-fill" data-hero-fill></span>
				</span>
				<span class="hero__slider-status" data-hero-status aria-hidden="true"></span>
			</button>
		</div>
	</div>
	<p class="hero__location">
		<span class="hero__location-main">PACHACAMÁC, LIMA</span>
		<span class="hero__location-sub">A OTRO RITMO</span>
	</p>
</section>

<script>
	function initHero(hero: HTMLElement) {
		const images = Array.from(hero.querySelectorAll<HTMLElement>("[data-hero-image]"));
		const texts = Array.from(hero.querySelectorAll<HTMLElement>("[data-hero-text]"));
		const fill = hero.querySelector<HTMLElement>("[data-hero-fill]");
		const counter = hero.querySelector<HTMLElement>("[data-hero-counter]");
		const pauseTargets = hero.querySelectorAll<HTMLElement>(".hero__cta");
		const status = hero.querySelector<HTMLElement>("[data-hero-status]");
		const pauseButton = hero.querySelector<HTMLButtonElement>("[data-hero-pause]");
		const total = images.length;
		if (total <= 1) return;

		const duration = Number(hero.dataset.slideDuration) || 6000;
		const digits = Math.max(2, String(total).length);
		let index = 0;
		let elapsed = 0;
		let lastTick = 0;
		let paused = false;
		// Autoplay starts paused for people who ask for reduced motion; the button toggles it.
		let userPaused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		function syncPauseButton() {
			pauseButton?.setAttribute("aria-pressed", String(userPaused));
			const label = userPaused ? "Reanudar carrusel" : "Pausar carrusel";
			pauseButton?.setAttribute("aria-label", label);
			pauseButton?.setAttribute("title", label);
			if (status) status.textContent = userPaused ? "PAUSA" : "";
		}

		function setSlide(i: number) {
			index = i;
			images.forEach((img, idx) => img.classList.toggle("is-active", idx === i));
			texts.forEach((txt, idx) => txt.classList.toggle("is-active", idx === i));
			if (counter)
				counter.textContent = `${String(i + 1).padStart(digits, "0")}/${String(total).padStart(digits, "0")}`;
		}

		function tick(now: number) {
			if (!paused && !userPaused) {
				elapsed += now - lastTick;
				if (elapsed >= duration) {
					elapsed = 0;
					setSlide((index + 1) % total);
				}
				if (fill) fill.style.width = `${Math.min((elapsed / duration) * 100, 100)}%`;
			}
			lastTick = now;
			requestAnimationFrame(tick);
		}

		function pause() {
			paused = true;
		}

		function resume() {
			paused = false;
		}

		pauseButton?.addEventListener("click", () => {
			userPaused = !userPaused;
			syncPauseButton();
		});

		syncPauseButton();
		setSlide(0);
		lastTick = performance.now();
		requestAnimationFrame(tick);

		pauseTargets.forEach((el) => {
			el.addEventListener("mouseenter", pause);
			el.addEventListener("mouseleave", resume);
			el.addEventListener("focusin", pause);
			el.addEventListener("focusout", resume);
		});
	}

	document.querySelectorAll<HTMLElement>("[data-hero]").forEach(initHero);
</script>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
	}

	.hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		opacity: 0;
		transition: opacity 1200ms var(--ease-calm);
	}

	.hero__image.is-active {
		opacity: 1;
		animation: hero-settle 16s var(--ease-calm) both;
	}

	/* The active photo slowly settles from a slight zoom; it never delays the first paint. */
	@keyframes hero-settle {
		from {
			scale: 1.06;
		}
		to {
			scale: 1;
		}
	}

	/* Text and controls enter one after another on load. */
	.hero__subtitle {
		--reveal-delay: 150ms;
	}

	.hero__cta {
		--reveal-delay: 300ms;
	}

	.hero__controls {
		--reveal-delay: 450ms;
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(
				90deg,
				rgba(20, 15, 11, 0.78) 0%,
				rgba(20, 15, 11, 0.5) 32%,
				rgba(20, 15, 11, 0.2) 70%,
				rgba(20, 15, 11, 0.14) 100%
			),
			linear-gradient(
				180deg,
				rgba(20, 15, 11, 0.18) 0%,
				rgba(20, 15, 11, 0) 50%,
				rgba(20, 15, 11, 0.32) 100%
			);
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.875rem;
		max-width: 40rem;
		padding: 5rem var(--gutter) 2rem;
		color: var(--color-text-image);
	}

	.hero__text-stack {
		display: grid;
		width: 100%;
	}

	.hero__text {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: 1.875rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 800ms var(--ease-calm);
	}

	.hero__text.is-active {
		opacity: 1;
		visibility: visible;
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h1);
		font-weight: 400;
		line-height: 1.1;
		color: var(--color-text-image);
	}

	.hero__subtitle {
		font-family: var(--font-ui);
		font-size: var(--text-body-lg);
		color: var(--color-dark-sand);
	}

	.hero__cta {
		border-color: var(--color-dark-sand);
		color: var(--color-text-image);
		text-transform: none;
		letter-spacing: 0.07em;
		font-weight: 600;
	}

	.hero__controls {
		display: flex;
		align-items: center;
		gap: var(--space-sm);
		width: 100%;
	}

	/* The progress indicator is also the pause control: no extra icon, just a quiet affordance. */
	.hero__slider {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		min-height: 44px;
		padding: 0;
		border: 0;
		background: none;
		font-family: inherit;
		font-size: var(--text-small);
		letter-spacing: 0.16em;
		color: var(--color-dark-sand);
		cursor: pointer;
		transition: color var(--duration-fast) var(--ease-calm);
	}

	.hero__slider:hover {
		color: var(--color-text-image);
	}

	.hero__slider:focus-visible {
		outline: 2px solid var(--color-text-image);
		outline-offset: 4px;
	}

	.hero__slider-status {
		font-size: var(--text-eyebrow);
		letter-spacing: var(--tracking-widest);
		color: var(--color-camel);
	}

	.hero__slider-track {
		display: block;
		position: relative;
		height: 2px;
		width: 10rem;
		background: rgba(241, 234, 226, 0.3);
	}

	.hero__slider-fill {
		display: block;
		position: absolute;
		inset: 0 auto 0 0;
		width: 0%;
		background: var(--color-dark-sand);
	}

	.hero__location {
		position: absolute;
		right: var(--gutter);
		bottom: 2rem;
		display: none;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		text-align: right;
	}

	.hero__location-main {
		font-size: var(--text-body);
		letter-spacing: 0.12em;
		color: var(--color-text-image);
	}

	.hero__location-sub {
		font-size: var(--text-small);
		letter-spacing: 0.08em;
		color: var(--color-dark-sand);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__image.is-active {
			animation: none;
		}
	}

	@media (min-width: 768px) {
		.hero__location {
			display: flex;
		}

		.hero__title {
			white-space: nowrap;
		}
	}
</style>
