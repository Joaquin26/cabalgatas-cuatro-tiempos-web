---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import avatarImage from "../../assets/testimonios/avatar.jpg";

const reviews = [
	{
		quote:
			"“Una experiencia increíble, todo estuvo perfecto. Los caballos, el paisaje, la comida... simplemente mágico.“",
		name: "Maria P.",
		experience: "Full Day a Caballo",
	},
	{
		quote:
			"“Nunca había montado y me sentí super seguro. El equipo es muy atento y el lugar es hermoso.“",
		name: "Carlos R.",
		experience: "Cabalgata 2h",
	},
	{
		quote:
			"“Fue el plan perfecto con amigas. Desconectamos, disfrutamos y nos fuimos con ganas de volver. “",
		name: "Valentina M.",
		experience: "Pilates & Horses",
	},
	{
		quote:
			"“El paisaje al atardecer es espectacular. Volvería mil veces solo por esa vista desde el valle.“",
		name: "Diego S.",
		experience: "Cabalgata 2h",
	},
	{
		quote:
			"“Organizamos el cumpleaños de mi hija ahí y fue perfecto. Atención de primera del inicio al fin.“",
		name: "Andrea L.",
		experience: "Celebra a tu Manera",
	},
];
---

<section class="reviews section" data-reviews>
	<div class="reviews__header reveal">
		<SectionHeader eyebrow="LO QUE DICEN NUESTROS VISITANTES" title="Experiencias reales" />
		<div class="reviews__nav">
			<button
				type="button"
				class="reviews__nav-button"
				data-reviews-prev
				aria-label="Testimonio anterior"
			>
				←
			</button>
			<button
				type="button"
				class="reviews__nav-button"
				data-reviews-next
				aria-label="Siguiente testimonio"
			>
				→
			</button>
		</div>
	</div>
	<ul class="reviews__grid" data-stagger>
		{reviews.map((review) => (
			<li class="review-card">
				<p class="review-card__quote">{review.quote}</p>
				<div class="review-card__author">
					<Image src={avatarImage} alt="" width={45} height={45} class="review-card__avatar" />
					<div class="review-card__meta">
						<p class="review-card__name">{review.name}</p>
						<p class="review-card__experience">{review.experience}</p>
					</div>
				</div>
			</li>
		))}
	</ul>
</section>

<script>
	function initReviews(section: HTMLElement) {
		const track = section.querySelector<HTMLElement>(".reviews__grid");
		const prev = section.querySelector<HTMLButtonElement>("[data-reviews-prev]");
		const next = section.querySelector<HTMLButtonElement>("[data-reviews-next]");
		if (!track) return;

		const originals = Array.from(track.children) as HTMLElement[];
		const count = originals.length;
		if (count < 2) return;

		function cloneSet() {
			return originals.map((card) => {
				const clone = card.cloneNode(true) as HTMLElement;
				clone.setAttribute("aria-hidden", "true");
				clone.setAttribute("inert", "");
				return clone;
			});
		}

		// [clones of last set][real cards][clones of first set] — lets scrolling in
		// either direction always land on visually-identical content, so the loop
		// reset below never has anything to visibly jump across.
		const before = cloneSet();
		const after = cloneSet();
		before.forEach((clone) => track!.appendChild(clone));
		after.forEach((clone) => track!.appendChild(clone));
		const allCards = Array.from(track.children) as HTMLElement[];
		for (let i = 0; i < count; i++) {
			track!.insertBefore(allCards[count + i], allCards[0]);
		}

		function stepWidth() {
			const card = track!.querySelector<HTMLElement>(".review-card");
			const gap = parseFloat(getComputedStyle(track!).columnGap || "0");
			return card ? card.offsetWidth + gap : 0;
		}

		function jumpTo(scrollLeft: number) {
			track!.style.scrollBehavior = "auto";
			track!.scrollLeft = scrollLeft;
			track!.style.scrollBehavior = "";
		}

		const realStart = track.children[count] as HTMLElement;
		let realStartLeft = 0;
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				realStartLeft =
					realStart.getBoundingClientRect().left - track!.getBoundingClientRect().left;
				jumpTo(realStartLeft);
			});
		});

		function scrollByCard(direction: 1 | -1) {
			track!.scrollBy({ left: direction * stepWidth(), behavior: "smooth" });
		}

		function settleLoop() {
			const step = stepWidth();
			if (!step) return;
			const span = count * step;
			const offset = track!.scrollLeft - realStartLeft;
			if (offset >= span - 1) {
				jumpTo(track!.scrollLeft - span);
			} else if (offset <= -span + 1) {
				jumpTo(track!.scrollLeft + span);
			}
		}

		track.addEventListener("scrollend", settleLoop);

		prev?.addEventListener("click", () => scrollByCard(-1));
		next?.addEventListener("click", () => scrollByCard(1));
	}

	document.querySelectorAll<HTMLElement>("[data-reviews]").forEach(initReviews);
</script>

<style>
	.reviews {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.reviews__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.reviews__nav {
		display: flex;
		gap: 0.9rem;
	}

	.reviews__nav-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.125rem;
		height: 3.125rem;
		border-radius: 50%;
		border: 1px solid var(--color-dark-sand);
		background: transparent;
		color: inherit;
		font-family: inherit;
		font-size: 1.5rem;
		cursor: pointer;
		padding: 0;
		transition:
			background-color var(--duration-fast) var(--ease-calm),
			color var(--duration-fast) var(--ease-calm),
			border-color var(--duration-fast) var(--ease-calm),
			transform var(--duration-fast) var(--ease-calm);
	}

	@media (hover: hover) {
		.reviews__nav-button:hover {
			background: var(--color-chocolate);
			border-color: var(--color-chocolate);
			color: var(--color-text-image);
		}

		[data-reviews-prev]:hover {
			transform: translateX(-0.125rem);
		}

		[data-reviews-next]:hover {
			transform: translateX(0.125rem);
		}
	}

	.reviews__nav-button:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	.reviews__nav-button:active {
		transform: scale(0.96);
	}

	.reviews__grid {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.reviews__grid::-webkit-scrollbar {
		display: none;
	}

	.review-card {
		background: var(--color-main);
		border: 1px solid var(--color-sand);
		border-radius: var(--radius-card);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		flex: 0 0 85%;
		scroll-snap-align: start;
	}

	.review-card__quote {
		font-size: var(--text-body);
		line-height: 1.5;
		min-height: 4.5rem;
		color: var(--color-brown);
	}

	.review-card__author {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.review-card__avatar {
		border-radius: 50%;
		width: 2.8125rem;
		height: 2.8125rem;
		object-fit: cover;
	}

	.review-card__meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.review-card__name {
		font-weight: 600;
		font-size: var(--text-small);
		color: var(--color-chocolate);
	}

	.review-card__experience {
		font-weight: 600;
		font-size: var(--text-eyebrow);
		color: var(--color-chocolate);
	}

	@media (min-width: 1024px) {
		.review-card {
			flex-basis: calc((100% - 2rem) / 3);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reviews__grid {
			scroll-behavior: auto;
		}
	}
</style>
