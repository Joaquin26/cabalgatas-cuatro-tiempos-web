---
import { Image } from "astro:assets";
import SectionHeader from "../ui/SectionHeader.astro";
import avatarImage from "../../assets/testimonios/avatar.png";

const reviews = [
	{
		quote:
			"“Una experiencia increíble, todo estuvo perfecto. Los caballos, el paisaje, la comida... simplemente mágico.“",
		name: "Maria P.",
		experience: "Full Day a Caballo",
	},
	{
		quote:
			"“Nunca había montado y me sentí super seguro. El equipo es muy atento y el lugar es hermoso.“",
		name: "Carlos R.",
		experience: "Cabalgata 2h",
	},
	{
		quote:
			"“Fue el plan perfecto con amigas. Desconectamos, disfrutamos y nos fuimos con ganas de volver. “",
		name: "Valentina M.",
		experience: "Pilates & Horses",
	},
];
---

<section class="reviews section">
	<div class="reviews__header reveal">
		<SectionHeader eyebrow="LO QUE DICEN NUESTROS VISITANTES" title="Experiencias reales" />
		<div class="reviews__nav" aria-hidden="true">
			<span class="reviews__nav-button">←</span>
			<span class="reviews__nav-button">→</span>
		</div>
	</div>
	<ul class="reviews__grid reveal">
		{reviews.map((review) => (
			<li class="review-card">
				<p class="review-card__quote">{review.quote}</p>
				<div class="review-card__author">
					<Image src={avatarImage} alt="" width={45} height={45} class="review-card__avatar" />
					<div>
						<p class="review-card__name">{review.name}</p>
						<p class="review-card__experience">{review.experience}</p>
					</div>
				</div>
			</li>
		))}
	</ul>
</section>

<style>
	.reviews {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.reviews__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
	}

	.reviews__nav {
		display: none;
		gap: 0.9rem;
	}

	.reviews__nav-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 3.125rem;
		height: 3.125rem;
		border-radius: 50%;
		border: 1px solid var(--color-dark-sand);
		font-size: 1.5rem;
	}

	.reviews__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.review-card {
		background: var(--color-main);
		border: 1px solid #ded3c9;
		border-radius: var(--radius-card);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.3rem;
	}

	.review-card__quote {
		font-size: var(--text-body);
		line-height: 1.5;
		color: #4c4037;
	}

	.review-card__author {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.review-card__avatar {
		border-radius: 50%;
		width: 2.8125rem;
		height: 2.8125rem;
		object-fit: cover;
	}

	.review-card__name {
		font-weight: 600;
		font-size: var(--text-small);
		color: var(--color-chocolate);
	}

	.review-card__experience {
		font-weight: 600;
		font-size: var(--text-eyebrow);
		color: var(--color-chocolate);
	}

	@media (min-width: 1024px) {
		.reviews__nav {
			display: flex;
		}

		.reviews__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
