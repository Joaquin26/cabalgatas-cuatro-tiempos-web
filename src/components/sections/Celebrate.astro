---
import { Image } from "astro:assets";
import Zoomable from "../ui/Zoomable.astro";
import { whatsappLink, messages } from "../../data/contact";
import celebrateImage from "../../assets/experiencias/celebra-a-tu-manera/hero.png";

const tags = ["GRUPOS", "CUMPLEAÑOS", "ANIVERSARIOS", "EXPERIENCIAS PRIVADAS"];
---

<section class="celebrate" id="celebra">
	<div class="celebrate__inner">
		<div class="celebrate__content reveal">
			<div class="celebrate__text">
				<div class="celebrate__heading">
					<p class="eyebrow eyebrow--dark celebrate__eyebrow">EXPERIENCIAS ESPECIALES</p>
					<h2>Celebra a tu manera</h2>
				</div>
				<p class="celebrate__body">
					Cumpleaños, aniversarios, reuniones especiales o simplemente una buena excusa para
					compartir
				</p>
			</div>
			<a href={whatsappLink(messages.celebration)} class="button button--secondary celebrate__cta">
				CUÉNTANOS TU IDEA →
			</a>
		</div>
		<div class="celebrate__media reveal">
			<div class="celebrate__image">
				<Zoomable
					src={celebrateImage}
					alt="Mesa servida al aire libre para una celebración en Cuatro Tiempos"
				>
					<Image
						class="parallax"
						src={celebrateImage}
						alt="Mesa servida al aire libre para una celebración en Cuatro Tiempos"
						width={520}
						height={400}
					/>
				</Zoomable>
			</div>
			<ul class="celebrate__tags">
				{tags.map((tag) => (
					<li>{tag}</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	/* Phones and tablets: the arch photo is the finale; it fills the width and runs into the bottom
	   edge of the section, as it bleeds off the edges on desktop. */
	.celebrate {
		background: var(--color-chocolate);
		padding: 3.5rem var(--gutter) 0;
	}

	.celebrate__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	.celebrate__content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.celebrate__text {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.celebrate__heading {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.celebrate__content h2 {
		font-size: var(--text-h2);
		font-weight: 400;
		color: var(--color-main);
	}

	.celebrate__body {
		font-size: var(--text-body);
		line-height: 1.5;
		color: var(--color-dark-sand);
		max-width: 24rem;
	}

	.celebrate__cta {
		border-color: var(--color-dark-sand);
		color: var(--color-text-image);
		text-transform: none;
		letter-spacing: 0.08em;
	}

	.celebrate__cta:hover {
		background: var(--color-brown);
		color: var(--color-text-image);
	}

	/* Slightly larger than its arch so the soft parallax never exposes an edge. */
	.celebrate__image :global(img) {
		scale: 1.1;
	}

	.celebrate__media {
		display: flex;
		align-items: flex-end;
		gap: var(--space-grid-gap);
	}

	.celebrate__image {
		flex: 0 0 66%;
		max-width: 22rem;
		aspect-ratio: 5 / 6;
		overflow: hidden;
		border-radius: 50% 50% 0 0;
	}

	@media (min-width: 1024px) {
		.celebrate {
			padding-bottom: 3.5rem;
		}

		.celebrate__media {
			align-self: stretch;
			align-items: center;
		}

		.celebrate__image {
			flex: none;
			width: 34rem;
			max-width: none;
			height: calc(100% + 7rem);
			margin-block: -3.5rem;
			margin-inline: 0;
			aspect-ratio: 520 / 400;
		}
	}

	.celebrate__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.celebrate__tags {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		margin: 0;
		padding: 0 0 var(--space-lg);
		list-style: none;
		font-size: var(--text-small);
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--color-dark-sand);
	}

	@media (min-width: 1024px) {
		.celebrate__tags {
			justify-content: space-between;
			gap: 1rem;
			padding-bottom: 0;
		}

		.celebrate__inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			min-height: 23.75rem;
			max-width: 84rem;
		}

		.celebrate__content {
			justify-content: space-between;
			height: 100%;
			padding: 4.5rem 0;
			max-width: 26rem;
		}

		.celebrate__media {
			gap: 4.5rem;
		}
	}
</style>
