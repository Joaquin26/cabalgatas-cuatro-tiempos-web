---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow: string;
	title: string;
	subtitle: string;
	/** Short key facts under the subtitle, such as days, length and price. */
	facts?: { full: string; short: string }[];
	/** Where the photo is anchored on phones (an object-position value), when its subject is off centre. */
	mobilePosition?: string;
}

const { image, alt, eyebrow, title, subtitle, facts = [], mobilePosition } = Astro.props;
---

<section
	class="page-hero"
	data-hero
	style={mobilePosition ? `--hero-position-mobile: ${mobilePosition}` : undefined}
>
	<Image
		src={image}
		alt={alt}
		class="page-hero__image"
		widths={[720, 1440, 2160]}
		sizes="100vw"
		loading="eager"
		priority
	/>
	<div class="page-hero__scrim" aria-hidden="true"></div>
	<div class="page-hero__content">
		<div class="page-hero__title reveal">
			<span class="page-hero__eyebrow">{eyebrow}</span>
			<h1>{title}</h1>
		</div>
		<p class="reveal page-hero__subtitle">{subtitle}</p>
		{facts.length > 0 && (
			<div class="reveal page-hero__facts">
				<ul>
					{facts.map((fact) => (
						<li>
							<span class="fact-full">{fact.full}</span>
							<span class="fact-short" aria-hidden="true">
								{fact.short}
							</span>
						</li>
					))}
				</ul>
			</div>
		)}
	</div>
	<p class="page-hero__location">
		<span class="page-hero__location-main">PACHACÁMAC, LIMA</span>
		<span class="page-hero__location-sub">A OTRO RITMO</span>
	</p>
</section>

<style>
	.page-hero {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		color: var(--color-text-image);
	}

	/* Text enters in sequence; the photo slowly settles from a slight zoom (same as the home hero). */
	.page-hero__subtitle {
		--reveal-delay: 150ms;
	}

	/* A plain CSS animation (not .reveal): this block is hidden on phones and a scroll observer
	   would never fire for it, leaving it invisible if the screen is later rotated. */
	@keyframes page-hero-rise {
		from {
			opacity: 0;
			translate: 0 var(--reveal-distance);
		}
	}

	@keyframes page-hero-settle {
		from {
			scale: 1.06;
		}
		to {
			scale: 1;
		}
	}

	.page-hero__image {
		animation: page-hero-settle 16s var(--ease-calm) both;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.page-hero__scrim {
		--shade: var(--color-dark-chocolate);
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--shade) 78%, transparent) 0%,
				color-mix(in srgb, var(--shade) 54%, transparent) 34%,
				color-mix(in srgb, var(--shade) 14%, transparent) 70%,
				color-mix(in srgb, var(--shade) 6%, transparent) 100%
			),
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--shade) 18%, transparent) 0%,
				transparent 50%,
				color-mix(in srgb, var(--shade) 42%, transparent) 100%
			);
	}

	/* On phones the text runs nearly edge to edge, so the shade rises from the bottom instead of
	   coming in from the left. */
	@media (max-width: 767px) {
		.page-hero__image {
			object-position: var(--hero-position-mobile, 50% 50%);
		}

		.page-hero__scrim {
			--shade: var(--color-dark-chocolate);
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--shade) 30%, transparent) 0%,
				color-mix(in srgb, var(--shade) 8%, transparent) 30%,
				color-mix(in srgb, var(--shade) 62%, transparent) 55%,
				color-mix(in srgb, var(--shade) 86%, transparent) 100%
			);
		}
	}

	.page-hero__content {
		display: flex;
		flex-direction: column;
		gap: 1.875rem;
		box-sizing: content-box;
		max-width: 26.25rem;
		padding: 5rem var(--gutter) var(--section-spacing);
	}

	.page-hero__title {
		display: flex;
		flex-direction: column;
	}

	.page-hero__eyebrow {
		font-size: var(--text-eyebrow);
		font-weight: var(--weight-regular);
		letter-spacing: var(--tracking-widest);
		text-transform: uppercase;
		color: var(--color-dark-sand);
	}

	.page-hero__content h1 {
		font-size: var(--text-h1);
		font-weight: var(--weight-regular);
		line-height: 1.09;
		letter-spacing: var(--tracking-tight);
		color: var(--color-text-image);
	}

	.page-hero__content p {
		font-size: var(--text-body-lg);
		font-weight: var(--weight-regular);
		line-height: 1.4;
		letter-spacing: var(--tracking-tight);
		color: var(--color-dark-sand);
	}

	/* Days, length and price on one quiet line, split by thin rules. When the line wraps, the rule
	   that would start the new line falls in the clipped margin, so no line begins with a divider. */
	.page-hero__facts {
		--reveal-delay: 300ms;
		--fact-gap: var(--space-sm);
		/* The line may run wider than the text column above, so it stays on one line. */
		width: max-content;
		max-width: calc(100vw - 2 * var(--gutter));
		padding-top: var(--space-sm);
		border-top: 1px solid color-mix(in srgb, var(--color-dark-sand) 45%, transparent);
		overflow: hidden;
		font-size: var(--text-small);
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-image);
	}

	.page-hero__facts ul {
		display: flex;
		flex-wrap: wrap;
		row-gap: var(--space-xs);
		margin: 0 0 0 calc(-2 * var(--fact-gap) - 1px);
		padding: 0;
		list-style: none;
	}

	.page-hero__facts li {
		position: relative;
		padding-left: calc(2 * var(--fact-gap) + 1px);
		white-space: nowrap;
	}

	.page-hero__facts li::before {
		content: "";
		position: absolute;
		left: var(--fact-gap);
		top: 50%;
		width: 1px;
		height: 0.9em;
		translate: 0 -50%;
		background: var(--color-dark-sand);
		opacity: 0.6;
	}

	.page-hero__location {
		animation: page-hero-rise var(--duration-slow) var(--ease-calm) 300ms both;
		position: absolute;
		right: var(--gutter);
		bottom: 2rem;
		display: none;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
		letter-spacing: var(--tracking-wider);
	}

	@media (min-width: 768px) {
		.page-hero__location {
			display: flex;
		}
	}

	.page-hero__location-main {
		font-size: var(--text-body);
		color: var(--color-text-image);
	}

	.page-hero__location-sub {
		font-size: var(--text-small);
		letter-spacing: var(--tracking-wide);
		color: var(--color-dark-sand);
	}

	@media (prefers-reduced-motion: reduce) {
		.page-hero__image,
		.page-hero__location {
			animation: none;
		}
	}
</style>
