---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow: string;
	title: string;
	subtitle: string;
}

const { image, alt, eyebrow, title, subtitle } = Astro.props;
---

<section class="page-hero" data-hero>
	<Image
		src={image}
		alt={alt}
		class="page-hero__image"
		widths={[720, 1440, 2160]}
		sizes="100vw"
		loading="eager"
		priority
	/>
	<div class="page-hero__scrim" aria-hidden="true"></div>
	<div class="page-hero__content">
		<div class="page-hero__title">
			<span class="page-hero__eyebrow">{eyebrow}</span>
			<h1>{title}</h1>
		</div>
		<p>{subtitle}</p>
	</div>
	<p class="page-hero__location">
		<span class="page-hero__location-main">PACHACAMÁC, LIMA</span>
		<span class="page-hero__location-sub">A OTRO RITMO</span>
	</p>
</section>

<style>
	.page-hero {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		color: var(--color-text-image);
	}

	.page-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.page-hero__scrim {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(
				90deg,
				rgba(20, 15, 11, 0.72) 0%,
				rgba(20, 15, 11, 0.42) 32%,
				rgba(20, 15, 11, 0.1) 70%,
				rgba(20, 15, 11, 0.06) 100%
			),
			linear-gradient(
				180deg,
				rgba(20, 15, 11, 0.18) 0%,
				rgba(20, 15, 11, 0) 50%,
				rgba(20, 15, 11, 0.32) 100%
			);
	}

	.page-hero__content {
		display: flex;
		flex-direction: column;
		gap: 1.875rem;
		box-sizing: content-box;
		max-width: 26.25rem;
		padding: 5rem var(--gutter) var(--section-spacing);
	}

	.page-hero__title {
		display: flex;
		flex-direction: column;
	}

	.page-hero__eyebrow {
		font-size: var(--text-eyebrow);
		font-weight: 400;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-dark-sand);
	}

	.page-hero__content h1 {
		font-size: var(--text-h1);
		font-weight: 400;
		line-height: 1.09;
		letter-spacing: -0.01em;
		color: var(--color-text-image);
	}

	.page-hero__content p {
		font-size: var(--text-body-lg);
		font-weight: 400;
		line-height: 1.4;
		letter-spacing: -0.01em;
		color: var(--color-dark-sand);
	}

	.page-hero__location {
		position: absolute;
		right: var(--gutter);
		bottom: 2rem;
		display: none;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
		letter-spacing: 0.12em;
	}

	@media (min-width: 768px) {
		.page-hero__location {
			display: flex;
		}
	}

	.page-hero__location-main {
		font-size: var(--text-body);
		color: var(--color-text-image);
	}

	.page-hero__location-sub {
		font-size: var(--text-small);
		letter-spacing: 0.08em;
		color: var(--color-dark-sand);
	}
</style>
