---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow: string;
	title: string;
	text: string;
	align?: "left" | "right";
	action?: { label: string; href: string };
}

const { image, alt, eyebrow, title, text, align = "left", action } = Astro.props;
---

<section class:list={["band", `band--${align}`]}>
	<Image src={image} alt={alt} class="band__image" widths={[720, 1440, 2160]} sizes="100vw" />
	<div class="band__scrim" aria-hidden="true"></div>
	<div class="band__content reveal">
		<SectionHeader eyebrow={eyebrow} title={title} tone="dark" />
		<p>{text}</p>
		{action && (
			<a href={action.href} class="button button--secondary band__action">
				{action.label}
			</a>
		)}
	</div>
</section>

<style>
	.band {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 30.4375rem;
		padding: var(--space-xl) var(--gutter);
		overflow: hidden;
		background: var(--color-chocolate);
	}

	.band__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Darker on the side where the text sits. */
	.band__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				rgba(20, 15, 11, 0.08) 0%,
				rgba(20, 15, 11, 0) 50%,
				rgba(20, 15, 11, 0.18) 100%
			),
			linear-gradient(
				90deg,
				rgba(20, 15, 11, 0.58) 0%,
				rgba(20, 15, 11, 0.36) 38%,
				rgba(20, 15, 11, 0.1) 70%,
				rgba(20, 15, 11, 0.04) 100%
			);
	}

	.band--right .band__scrim {
		background:
			linear-gradient(
				180deg,
				rgba(20, 15, 11, 0.18) 0%,
				rgba(20, 15, 11, 0) 50%,
				rgba(20, 15, 11, 0.08) 100%
			),
			linear-gradient(
				270deg,
				rgba(20, 15, 11, 0.58) 0%,
				rgba(20, 15, 11, 0.36) 38%,
				rgba(20, 15, 11, 0.1) 70%,
				rgba(20, 15, 11, 0.04) 100%
			);
	}

	.band__content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-grid-gap);
		max-width: 33.75rem;
	}

	.band--right {
		justify-content: flex-end;
	}

	.band :global(.section-header h2) {
		color: var(--color-main);
	}

	.band__content p {
		line-height: 1.5;
		color: var(--color-sand);
	}

	.band__action {
		border-color: var(--color-text-image);
		color: var(--color-text-image);
	}

	.band__action:hover {
		background: var(--color-text-image);
		color: var(--color-chocolate);
	}
</style>
