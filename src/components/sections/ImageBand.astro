---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
	image: ImageMetadata;
	alt: string;
	eyebrow: string;
	title: string;
	text: string;
	align?: "left" | "right";
	action?: { label: string; href: string };
}

const { image, alt, eyebrow, title, text, align = "left", action } = Astro.props;
---

<section class:list={["band", `band--${align}`]}>
	<Image src={image} alt={alt} class="band__image" widths={[720, 1440, 2160]} sizes="100vw" />
	<div class="band__scrim" aria-hidden="true"></div>
	<div class="band__content reveal">
		<SectionHeader eyebrow={eyebrow} title={title} tone="dark" />
		<p>{text}</p>
		{action && (
			<a href={action.href} class="button button--secondary band__action">
				{action.label}
			</a>
		)}
	</div>
</section>

<style>
	.band {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 30.4375rem;
		padding: var(--space-xl) var(--gutter);
		overflow: hidden;
		background: var(--color-chocolate);
	}

	.band__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Darker on the side where the text sits: the text column spans about half the band, so the
	   shade holds until past its far edge and only then fades toward the photo. */
	.band__scrim {
		--shade: var(--color-dark-chocolate);
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--shade) 8%, transparent) 0%,
				transparent 50%,
				color-mix(in srgb, var(--shade) 18%, transparent) 100%
			),
			linear-gradient(
				var(--scrim-direction, 90deg),
				color-mix(in srgb, var(--shade) 80%, transparent) 0%,
				color-mix(in srgb, var(--shade) 66%, transparent) 50%,
				color-mix(in srgb, var(--shade) 24%, transparent) 78%,
				color-mix(in srgb, var(--shade) 6%, transparent) 100%
			);
	}

	.band--right .band__scrim {
		--scrim-direction: 270deg;
	}

	/* On phones the text spans the whole band, so the shade covers it evenly. */
	@media (max-width: 767px) {
		.band__scrim,
		.band--right .band__scrim {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--shade) 80%, transparent) 0%,
				color-mix(in srgb, var(--shade) 72%, transparent) 70%,
				color-mix(in srgb, var(--shade) 50%, transparent) 100%
			);
		}
	}

	.band__content {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-grid-gap);
		max-width: 33.75rem;
	}

	.band--right {
		justify-content: flex-end;
	}

	/* On a photo the eyebrow uses the light sand of the hero eyebrows; camel is too dim here. */
	.band :global(.eyebrow) {
		color: var(--color-dark-sand);
	}

	.band :global(.section-header h2) {
		color: var(--color-main);
	}

	.band__content p {
		line-height: 1.5;
		color: var(--color-sand);
	}

	.band__action {
		border-color: var(--color-text-image);
		color: var(--color-text-image);
	}

	.band__action:hover {
		background: var(--color-text-image);
		color: var(--color-chocolate);
	}
</style>
