---
import SectionHeader from "../ui/SectionHeader.astro";
import LinkArrow from "../ui/LinkArrow.astro";

const questions = [
	{
		question: "¿Necesito experiencia montando caballo?",
		answer:
			"No, todas nuestras cabalgatas están pensadas para principiantes. Nuestro equipo te acompaña en todo momento y los caballos están entrenados para pasear con jinetes de cualquier nivel.",
	},
	{
		question: "¿Desde que edad se puede participar?",
		answer:
			"Reciben visitantes desde los 8 años acompañados de un adulto. Para menores de 8 contamos con paseos cortos guiados dentro del picadero, consúltanos al reservar.",
	},
	{
		question: "¿Dónde están ubicados?",
		answer:
			"Estamos en el valle de Pachacámac, a unos 40 minutos del sur de Lima. Te enviamos la ubicación exacta y las indicaciones de acceso al confirmar tu reserva.",
	},
	{
		question: "¿Qué debo llevar?",
		answer:
			"Ropa cómoda, zapatos cerrados, bloqueador solar y ganas de disfrutar. Si tu experiencia incluye alimentos o bebidas te lo indicamos previamente.",
	},
	{
		question: "¿Qué pasa si necesito cambiar mi reserva?",
		answer:
			"Puedes reprogramar tu cabalgata sin costo hasta 24 horas antes de la actividad escribiéndonos por WhatsApp o correo.",
	},
];
---

<section class="faq-preview section">
	<div class="faq-preview__intro reveal">
		<SectionHeader
			eyebrow="PREGUNTAS FRECUENTES"
			title="Todo lo que necesitas saber"
			subtitle="Resolvemos las dudas más comunes para que solo tengas que preocuparte por disfrutar la experiencia."
		/>
		<LinkArrow href="/faq" label="VER TODAS LAS PREGUNTAS →" variant="underline" />
	</div>
	<div class="faq-preview__list reveal">
		{questions.map(({ question, answer }) => (
			<details class="faq-item">
				<summary>
					<span>{question}</span>
					<span class="faq-item__icon" aria-hidden="true">
						+
					</span>
				</summary>
				<p class="faq-item__answer">{answer}</p>
			</details>
		))}
	</div>
</section>

<style>
	.faq-preview {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.faq-preview__intro {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}

	.faq-preview__list {
		display: flex;
		flex-direction: column;
	}

	.faq-item {
		border-bottom: 1px solid var(--color-sand);
		padding: 0.9rem 0;
	}

	.faq-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		list-style: none;
		font-size: var(--text-small);
		color: var(--color-chocolate);
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item__icon {
		font-weight: 600;
		font-size: 1.5rem;
		color: var(--color-brown);
		transition: transform var(--duration-base) var(--ease-calm);
	}

	.faq-item[open] .faq-item__icon {
		transform: rotate(45deg);
	}

	.faq-item__answer {
		margin-top: 0.9rem;
		max-width: 34rem;
		font-size: var(--text-small);
		line-height: 1.5;
		color: var(--color-brown);
	}

	@media (min-width: 1024px) {
		.faq-preview {
			flex-direction: row;
			gap: 9rem;
		}

		.faq-preview__intro {
			flex-shrink: 0;
			width: 30rem;
		}

		.faq-preview__list {
			flex: 1;
			justify-content: center;
		}
	}
</style>
