---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeader from "../ui/SectionHeader.astro";
import defaultImage from "../../assets/inicio/momento.png";

interface Step {
	title: string;
	text: string;
	image?: ImageMetadata;
	alt?: string;
}

interface Props {
	title: string;
	steps: Step[];
}

const { title, steps } = Astro.props;
const columns = Math.min(steps.length, 4);
---

<section class="section steps">
	<SectionHeader title={title} align="center" />
	<ol class="steps__list" style={`--columns: ${columns}`}>
		{steps.map((step, i) => (
			<li class="steps__item">
				<div class="steps__image">
					<Image
						src={step.image ?? defaultImage}
						alt={step.alt ?? ""}
						widths={[400, 800]}
						sizes="(min-width: 1024px) 300px, 50vw"
					/>
				</div>
				<div class="steps__text">
					<span class="steps__number">{String(i + 1).padStart(2, "0")}</span>
					<h3>{step.title}</h3>
					<p>{step.text}</p>
				</div>
			</li>
		))}
	</ol>
</section>

<style>
	.steps {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	.steps__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg) var(--space-grid-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.steps__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.steps__image {
		position: relative;
		aspect-ratio: var(--ratio-photo-wide);
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	.steps__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Light brown tint over the photo, as in Figma. */
	.steps__image::after {
		content: "";
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--color-brown) 8%, transparent);
	}

	.steps__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.steps__number {
		font-size: var(--text-eyebrow);
		letter-spacing: var(--tracking-wide);
		color: var(--color-brown);
	}

	.steps__text h3 {
		font-size: var(--text-h4);
		font-weight: var(--weight-semibold);
		color: var(--color-chocolate);
	}

	.steps__text p {
		color: var(--color-chocolate);
	}

	@media (min-width: 640px) {
		.steps__list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.steps__list {
			grid-template-columns: repeat(var(--columns), 1fr);
		}
	}
</style>
