	},
	{
		image: photo("ruta-canal-2"),
		category: "cabalgatas",
		alt: "Jinete avanzando por el borde de un canal",
	},
	{
		image: photo("desayuno-valle"),
		category: "mesa",
		alt: "Desayuno servido en la terraza con vista al campo",
	},
	{
		image: photo("almuerzo-mesa"),
		category: "mesa",
		alt: "Mesa campestre servida con platos caseros",
	},
	{
		image: photo("ruta-sendero-2"),
		category: "cabalgatas",
		alt: "Jinetes en fila por un sendero de la quebrada",
	},
];

// MOCK: tiles with only the background color, until real photos arrive. Each category is
// topped up to PER_CATEGORY tiles, with mixed ratios, and interleaved so "Todos" looks varied.
const PER_CATEGORY = 7;
const ratios = [0.8, 1.5, 1, 1.33, 0.8, 1.5, 1];
const filterIds = categories.filter((c) => c.id !== "todos").map((c) => c.id);
const placeholders = filterIds.map((id, offset) =>
	Array.from({ length: PER_CATEGORY - photos.filter((p) => p.category === id).length }, (_, i) => ({
		category: id,
		ratio: ratios[(i + offset) % ratios.length],
	})),
);
const interleaved = Array.from({ length: PER_CATEGORY }, (_, i) =>
	placeholders.map((list) => list[i]).filter(Boolean),
).flat();

// Tall photos are capped at 4:5 (cropped by object-fit) so no row gets taller than the rest.
const MIN_RATIO = 0.8;
const tiles = [
	...photos.map((photo) => ({
		...photo,
		ratio: Math.max(photo.image.width / photo.image.height, MIN_RATIO),
	})),
	...interleaved,
];

// Full-size version of each real photo, loaded only when the viewer opens it.
const gallery = await Promise.all(
	tiles.map(async (tile, order) => ({
		...tile,
		order,
		full: "image" in tile ? (await getImage({ src: tile.image, width: 1600 })).src : undefined,
	})),
);
---

<BaseLayout title="Galería">
	<main>
		<PageHero
			image={hero}
			alt="Grupo de jinetes en fila por un sendero de la quebrada en Pachacámac"
			eyebrow="Galería"
			title="Momentos que se sienten"
			subtitle="Cabalgatas, naturaleza y días en el campo de Pachacamac."
		/>

		<section class="gallery" data-gallery data-page-size={PAGE_SIZE}>
			<ul class="gallery__categories reveal" aria-label="Categorías">
				{categories.map((category, i) => (
					<li>
						<button
							type="button"
							class="gallery__category"
							data-category={category.id}
							aria-pressed={i === 0 ? "true" : "false"}
						>
							{category.label}
						</button>
					</li>
				))}
			</ul>

			<div class="gallery__grid" data-gallery-grid role="list" data-lightbox-group>
				{gallery.map((tile) => (
					<div
						class="gallery__item"
						role="listitem"
						data-category={tile.category}
						data-ratio={tile.ratio}
						style={`--ratio: ${tile.ratio}`}
					>
						{"image" in tile ? (
							<button
								type="button"
								class="gallery__open"
								data-lightbox-open
								data-order={tile.order}
								data-full={tile.full}
								data-alt={tile.alt}
								aria-label={`Ampliar foto: ${tile.alt}`}
							>
								<Image
									src={tile.image}
									alt=""
									widths={[400, 800, 1200]}
									sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
								/>
							</button>
						) : (
							<div class="gallery__placeholder" aria-hidden="true" />
						)}
					</div>
				))}
			</div>

			<p class="gallery__empty" data-gallery-empty role="status" hidden>
				Pronto sumaremos momentos en esta categoría.
			</p>

			<div class="gallery__more-wrap reveal">
				<button type="button" class="button button--secondary gallery__more" data-gallery-more>
					VER MÁS MOMENTOS →
				</button>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	function initGallery(gallery: HTMLElement) {
		const pageSize = Number(gallery.dataset.pageSize) || 6;
		const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".gallery__category"));
		const grid = gallery.querySelector<HTMLElement>("[data-gallery-grid]")!;
		const items = Array.from(grid.querySelectorAll<HTMLElement>(".gallery__item"));
		const more = gallery.querySelector<HTMLButtonElement>("[data-gallery-more]");
		const empty = gallery.querySelector<HTMLElement>("[data-gallery-empty]");
		const mqTablet = window.matchMedia("(min-width: 768px)");
		const mqDesktop = window.matchMedia("(min-width: 1024px)");
		// Photos enter as they scroll into view, a beat apart. Photos already shown keep their state
		// when "Ver más" re-balances the columns; changing category replays the entrance.
		const seen = new IntersectionObserver(
			(entries) => {
				let i = 0;
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					el.style.setProperty("--d", `${i++ * 90}ms`);
					el.classList.add("is-in");
					seen.unobserve(el);
				}
			},
			{ rootMargin: "0px 0px -8% 0px" },
		);
		let category = "todos";
		let limit = pageSize;

		// Masonry: each photo goes to the currently shortest column. Columns are flex stacks of
		// equal height, and items grow in proportion to their height, so every column ends flush.
		function layout(visible: HTMLElement[]) {
			const count = Math.min(mqDesktop.matches ? 3 : mqTablet.matches ? 2 : 1, visible.length);
			const columns = Array.from({ length: count }, () => {
				const el = document.createElement("div");
				el.className = "gallery__col";
				return { el, height: 0 };
			});
			for (const item of visible) {
				const target = columns.reduce((a, b) => (b.height < a.height ? b : a));
				target.el.append(item);
				target.height += 1 / Number(item.dataset.ratio);
			}
			grid.replaceChildren(...columns.map((c) => c.el));
		}

		function render() {
			const matching = items.filter(
				(el) => category === "todos" || el.dataset.category === category,
			);
			const shown = matching.slice(0, limit);
			layout(shown);
			shown.forEach((el) => {
				if (!el.classList.contains("is-in")) seen.observe(el);
			});
			tabs.forEach((tab) =>
				tab.setAttribute("aria-pressed", String(tab.dataset.category === category)),
			);
			if (more) more.hidden = matching.length <= limit;
			if (empty) empty.hidden = matching.length > 0;
		}

		tabs.forEach((tab) =>
			tab.addEventListener("click", () => {
				category = tab.dataset.category ?? "todos";
				limit = pageSize;
				items.forEach((el) => {
					seen.unobserve(el);
					el.classList.remove("is-in");
				});
				render();
			}),
		);

		more?.addEventListener("click", () => {
			limit += pageSize;
			render();
		});

		mqTablet.addEventListener("change", render);
		mqDesktop.addEventListener("change", render);

		render();
	}

	document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(initGallery);
</script>

<style>
	.gallery {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-header-gap);
		padding: var(--section-spacing) var(--gutter);
	}

	.gallery__categories {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.gallery__category {
		min-height: 44px;
		padding: 0 0 0.5rem;
		background: none;
		border: 0;
		border-bottom: 2px solid transparent;
		cursor: pointer;
		font-family: inherit;
		font-size: var(--text-small);
		font-weight: var(--weight-semibold);
		letter-spacing: var(--tracking-widest);
		text-transform: uppercase;
		color: var(--color-chocolate);
		transition: border-color var(--duration-base) var(--ease-calm);
	}

	.gallery__category:hover,
	.gallery__category[aria-pressed="true"] {
		border-bottom-color: var(--color-camel);
	}

	.gallery__category:focus-visible,
	.gallery__more:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	.gallery__placeholder {
		background: var(--color-sand);
	}

	.gallery__empty {
		color: var(--color-brown);
	}

	.gallery__more[hidden] {
		display: none;
	}

	/* Masonry columns are built by the script; without JS, items simply stack. */
	.gallery__grid {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-gallery-gap);
		width: 100%;
		max-width: var(--content-width);
	}

	@media (min-width: 768px) {
		.gallery__grid {
			flex-direction: row;
		}
	}

	.gallery__grid > :global(.gallery__col) {
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		gap: var(--space-gallery-gap);
		min-width: 0;
	}

	/* Natural height from the ratio; shorter columns stretch their items to end flush. */
	.gallery__item {
		flex: calc(1000 / var(--ratio)) 1 auto;
		aspect-ratio: var(--ratio);
		min-height: 0;
		overflow: hidden;
		border-radius: var(--radius-card);
	}

	/* Entrance: only with JavaScript, so photos are never trapped invisible without it. */
	:global(.has-js) .gallery__item {
		opacity: 0;
		transform: translateY(var(--reveal-distance));
		transition:
			opacity var(--duration-slow) var(--ease-calm) var(--d, 0ms),
			transform var(--duration-slow) var(--ease-calm) var(--d, 0ms);
	}

	:global(.has-js) .gallery__item.is-in {
		opacity: 1;
		transform: none;
	}

	:global(.has-js) .gallery__item :global(img) {
		scale: 1.06;
		transition: scale var(--duration-image) var(--ease-calm) var(--d, 0ms);
	}

	:global(.has-js) .gallery__item.is-in :global(img) {
		scale: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.has-js) .gallery__item {
			opacity: 1;
			transform: none;
			transition: none;
		}

		:global(.has-js) .gallery__item :global(img) {
			scale: none;
			transition: none;
		}
	}

	.gallery__open {
		display: block;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	.gallery__open:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: -4px;
	}

	.gallery__item :global(img),
	.gallery__placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
