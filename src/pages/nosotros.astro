---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import StorySection from "../components/sections/StorySection.astro";
import ImageBand from "../components/sections/ImageBand.astro";
import hero from "../assets/galeria/hero.jpg";
import story from "../assets/nosotros/historia.jpg";
import place from "../assets/nosotros/lugar.jpg";

// MOCK: second sentences are draft copy built only from claims already on this page;
// confirm or replace with the client's wording.
const values = [
	{
		title: "Bienestar de los caballos",
		text: "Su cuidado y equilibrio siempre van primero, son el corazón de todo lo que hacemos. Respetamos sus ritmos y su descanso, y cada recorrido se piensa a su medida antes que a la nuestra.",
	},
	{
		title: "Experiencias cuidadas",
		text: "Grupos pequeños, atención personalizada y un ritmo que respeta el entorno. Cada detalle, desde la llegada hasta el cierre del día, está pensado para que te sientas acompañado y sin prisa.",
	},
	{
		title: "Conexión con el campo",
		text: "Queremos que cada visita sea una pausa real para reconectar contigo, con la naturaleza, con lo simple. Aquí el campo abierto, las montañas y los caminos hacen el resto.",
	},
];

// MOCK: only the first member is real; the rest are test names and roles, no photos yet.
const team = [
	{ name: "Daniella", role: "Fundadora" },
	{ name: "Nombre Apellido", role: "Guía de campo" },
	{ name: "Nombre Apellido", role: "Cuidado de caballos" },
	{ name: "Nombre Apellido", role: "Atención a visitantes" },
	{ name: "Nombre Apellido", role: "Cocina" },
];
---

<BaseLayout title="Nosotros">
	<main>
		<PageHero
			image={hero}
			alt="Grupo de jinetes recorriendo un camino entre árboles en Pachacámac"
			eyebrow="Nosotros"
			title="Una forma distinta de vivir"
			subtitle="Aquí conocerás más de cómo nació esta experiencia que compartimos."
		/>

		<StorySection
			eyebrow="Nuestra historia"
			title="Más que un proyecto, una forma de vida."
			paragraphs={[
				"Cabalgatas Cuatro Tiempos nació del amor por los caballos, la naturaleza y los días sin prisa. Lo que empezó como una pasión personal, se convirtió en un espacio para compartir con otros todo lo bueno que no da el campo.",
				"Creemos en experiencias reales, en el respeto por los caballos y en el valor de desconectarse de la rutina, aunque sea por un día.",
			]}
			image={story}
			alt="Mujer sonriendo junto a un caballo, sosteniendo un letrero de Cabalgatas Cuatro Tiempos"
		/>

		<ImageBand
			image={place}
			alt="Valle y montañas de Pachacámac al atardecer"
			eyebrow="Pachacamac, Lima"
			title="Nuestro lugar para desconectar de la ciudad"
			text="Campo abierto, montañas y caminos que nos recuerdan lo esencial, a pocos kilómetros de Lima."
		/>

		<section class="section values">
			<h2 class="eyebrow reveal">Lo que nos define</h2>
			<ul class="values__list" data-stagger>
				{values.map((value) => (
					<li class="values__item">
						<h3>{value.title}</h3>
						<p>{value.text}</p>
					</li>
				))}
			</ul>
		</section>

		<section class="section team">
			<div class="team__header reveal">
				<SectionHeader
					eyebrow="Las personas detrás"
					title="Un equipo que comparte la misma pasión"
					class="team__heading"
				/>
				<p>
					Personas que aman los caballos, valoran la naturaleza y creen en el poder de las
					experiencias bien hechas.
				</p>
			</div>
			<ul class="team__grid" data-stagger>
				{team.map((member) => (
					<li class="team__member">
						<div class="team__photo" aria-hidden="true"></div>
						<p class="team__name">{member.name}</p>
						<p class="team__role">{member.role}</p>
					</li>
				))}
			</ul>
		</section>
	</main>
</BaseLayout>

<style>
	.values {
		display: flex;
		flex-direction: column;
		gap: var(--space-grid-gap);
		padding-block: var(--space-lg);
	}

	.values__label {
		font-family: var(--font-ui);
		font-weight: var(--weight-semibold);
		line-height: 1.5;
		color: var(--color-chocolate);
	}

	.values__list {
		display: grid;
		gap: var(--space-lg);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.values__item {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: var(--space-grid-gap);
	}

	/* Figma draws these at 48px; h3 size keeps them below the section h2s. */
	.values h3 {
		font-size: var(--text-h3);
	}

	.values__item p {
		font-size: var(--text-body);
		line-height: 1.5;
		color: var(--color-chocolate);
	}

	.team {
		display: flex;
		flex-direction: column;
		gap: var(--space-header-gap);
	}

	.team__header {
		display: flex;
		flex-direction: column;
		gap: var(--space-grid-gap);
	}

	.team__header p {
		line-height: 1.5;
		color: var(--color-brown);
	}

	.team__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-grid-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.team__member {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.team__photo {
		aspect-ratio: var(--ratio-photo-tall);
		/* With the member gap this makes 16px photo→name, 8px name→role. */
		margin-bottom: var(--space-xs);
		border-radius: var(--radius-card);
		background: var(--color-sand);
	}

	.team__name {
		font-size: var(--text-card-title);
		font-weight: var(--weight-semibold);
		line-height: 1.5;
		color: var(--color-chocolate);
	}

	.team__role {
		font-size: var(--text-small);
		line-height: 1.5;
		color: var(--color-brown);
	}

	@media (min-width: 768px) {
		.team__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.values__list {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-xl);
		}

		/* Vertical dividers between the three values, as drawn in Figma. */
		.values__item:not(:first-child) {
			position: relative;
		}

		.values__item:not(:first-child)::before {
			content: "";
			position: absolute;
			top: 0;
			bottom: 0;
			left: calc(var(--space-xl) / -2);
			width: 1px;
			background: var(--color-chocolate);
		}

		.team__header {
			flex-direction: row;
			align-items: flex-end;
			justify-content: space-between;
			gap: calc(var(--space-xl) * 2);
		}

		.team__heading {
			flex: 0 0 46.875rem;
		}

		.team__header p {
			flex: 1;
		}

		.team__grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}
</style>
