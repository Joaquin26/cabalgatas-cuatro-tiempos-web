---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import StorySection from "../../components/sections/StorySection.astro";
import ExperienceSteps from "../../components/sections/ExperienceSteps.astro";
import ImageBand from "../../components/sections/ImageBand.astro";
import ExperienceIncludes from "../../components/sections/ExperienceIncludes.astro";
import BookingDialog from "../../components/sections/BookingDialog.astro";
import GalleryPreview from "../../components/sections/GalleryPreview.astro";
import ExperienceFaq from "../../components/sections/ExperienceFaq.astro";
import ExperienceClosing from "../../components/sections/ExperienceClosing.astro";
import BookingBar from "../../components/sections/BookingBar.astro";
import { whatsappLink, messages } from "../../data/contact";
import { scheduleLabel } from "../../data/availability";

export async function getStaticPaths() {
	const experiencias = await getCollection("experiencias");
	return experiencias.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { data } = Astro.props.entry;

// MOCK: there is no booking flow yet, so every "reservar" button opens WhatsApp.
const bookingHref = whatsappLink(messages.booking(data.title));

// The key facts (days, length, price) shown in the hero, from the same data as the booking card.
const { price } = data.booking;
const priceLabel = `${price.currency} ${price.amount}`;
const facts = [scheduleLabel(data.booking.schedule), data.duration, `${priceLabel} ${price.unit}`];
---

<BaseLayout title={data.title} description={data.summary} bookingHref={bookingHref}>
	<main>
		<PageHero
			image={data.hero.image}
			alt={data.hero.alt}
			eyebrow={data.hero.eyebrow}
			title={data.hero.title}
			subtitle={data.hero.subtitle}
			facts={facts.filter(Boolean)}
		/>
		<StorySection
			eyebrow={data.intro.eyebrow}
			title={data.intro.title}
			paragraphs={data.intro.paragraphs}
			image={data.intro.image}
			alt={data.intro.alt}
		/>
		<ExperienceSteps title={data.stepsTitle} steps={data.steps} />
		<ImageBand
			image={data.place.image}
			alt={data.place.alt}
			eyebrow={data.place.eyebrow}
			title={data.place.title}
			text={data.place.text}
			action={data.place.action}
			align="right"
		/>
		<ExperienceIncludes
			title={data.includesTitle}
			includes={data.includes}
			requirements={data.requirements}
			booking={{ ...data.booking, href: bookingHref }}
		/>
		<GalleryPreview photos={data.gallery?.map(({ image, alt }) => ({ src: image, alt }))} />
		<ExperienceFaq title={data.faqTitle} questions={data.faq} />
		<ExperienceClosing
			title={data.closing.title}
			text={data.closing.text}
			cta={data.closing.cta}
			href={bookingHref}
			facts={facts.filter(Boolean)}
			image={data.closing.image}
			alt={data.closing.alt}
		/>
	</main>
	<BookingBar price={priceLabel} unit={price.unit} href={bookingHref} />
	<BookingDialog
		slug={Astro.props.entry.id}
		title={data.title}
		price={Number(data.booking.price.amount)}
		currency={data.booking.price.currency}
		schedule={data.booking.schedule}
	/>
</BaseLayout>
