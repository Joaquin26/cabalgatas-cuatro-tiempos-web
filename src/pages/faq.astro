// MOCK: contact data copied from Figma, not confirmed; the WhatsApp number is the footer's placeholder.
const contact = {
	whatsapp: "https://wa.me/51999999999",
	email: "cabalgatascuatrotiempos@gmail.com",
	hours: "Lun - Dom 9:00 a.m. - 6:00 p.m.",
};
---

<BaseLayout title="Preguntas frecuentes">
	<main>
		<PageHero
			image={hero}
			alt="Grupo de jinetes recorriendo un camino entre árboles en Pachacámac"
			eyebrow="FAQ"
			title="Resolvemos tus dudas"
			subtitle="Aquí encontrarás la información más importante para que vivas tu experiencia con tranquilidad."
		/>

		<section class="section faq" data-faq>
			<aside class="faq__sidebar">
				<ul class="faq__categories" aria-label="Categorías">
					{categories.map((category, i) => (
						<li>
							<button
								type="button"
								class="faq__category"
								data-category={category.id}
								aria-pressed={i === 0 ? "true" : "false"}
							>
								{category.label}
							</button>
						</li>
					))}
				</ul>
				<!-- MOCK: placeholder for a photo, as in Figma. -->
				<div class="faq__sidebar-photo" aria-hidden="true"></div>
			</aside>

			<div class="faq__main">
				{categories.map((category, i) => (
					<div class="faq__panel" data-panel={category.id} hidden={i !== 0}>
						<h2>{category.title}</h2>
						{category.questions.length > 0 ? (
							<div class="faq__list">
								{category.questions.map(({ question, answer }, qi) => (
									<details class="faq-item" open={qi === 0}>
										<summary>
											<span>{question}</span>
											<img class="faq-item__icon" src={chevron.src} alt="" width="15" height="10" />
										</summary>
										<p class="faq-item__answer">{answer}</p>
									</details>
								))}
							</div>
						) : (
							<p class="faq__empty">Pronto sumaremos preguntas en esta categoría.</p>
						)}
					</div>
				))}
			</div>
		</section>

		<section class="section contact">
			<!-- MOCK: placeholder for a photo, as in Figma. -->
			<div class="contact__photo" aria-hidden="true"></div>
			<SectionHeader
				eyebrow="¿No encuentras tu respuesta?"
				title="Escríbenos, estamos para ayudarte."
				subtitle="Si tienes una consulta especial, puedes escribirnos por whatsapp. Te responderemos lo antes posible."
			/>
			<div class="contact__actions">
				<a
					href={contact.whatsapp}
					class="button button--primary"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img src={whatsapp.src} alt="" width="24" height="24" />
					ESCRIBIR POR WHATSAPP →
				</a>
				<a href={`mailto:${contact.email}`} class="contact__line">
					<img src={email.src} alt="" width="24" height="24" />
					{contact.email}
				</a>
				<p class="contact__line">
					<img src={clock.src} alt="" width="24" height="24" />
					{contact.hours}
				</p>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	function initFaq(faq: HTMLElement) {
		const tabs = Array.from(faq.querySelectorAll<HTMLButtonElement>(".faq__category"));
		const panels = Array.from(faq.querySelectorAll<HTMLElement>("[data-panel]"));

		tabs.forEach((tab) =>
			tab.addEventListener("click", () => {
				const id = tab.dataset.category;
				tabs.forEach((t) => t.setAttribute("aria-pressed", String(t === tab)));
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.panel !== id;
				});
			}),
		);
	}

	document.querySelectorAll<HTMLElement>("[data-faq]").forEach(initFaq);
</script>

<style>
	.faq {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.faq__categories {
		display: flex;
		gap: var(--space-sm);
		margin: 0;
		padding: 0 0 var(--space-xs);
		list-style: none;
		overflow-x: auto;
	}

	.faq__category {
		min-height: 44px;
		padding: 0 var(--space-xs);
		background: none;
		border: 0;
		border-bottom: 2px solid transparent;
		cursor: pointer;
		font-family: inherit;
		font-size: var(--text-body-lg);
		font-weight: var(--weight-semibold);
		white-space: nowrap;
		color: var(--color-chocolate);
		transition: border-color var(--duration-base) var(--ease-calm);
	}

	.faq__category:hover,
	.faq__category[aria-pressed="true"] {
		border-bottom-color: var(--color-chocolate);
	}

	.faq__category:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	.faq__sidebar-photo,
	.contact__photo {
		border-radius: var(--radius-card);
		background: var(--color-sand);
	}

	.faq__sidebar-photo {
		display: none;
	}

	.faq__panel[hidden] {
		display: none;
	}

	.faq__panel h2 {
		margin-bottom: var(--space-grid-gap);
		padding-bottom: var(--space-grid-gap);
		border-bottom: 1px solid var(--color-chocolate);
		font-size: var(--text-h2);
		font-weight: var(--weight-regular);
		color: var(--color-chocolate);
	}

	.faq__empty {
		color: var(--color-brown);
	}

	.faq-item {
		border-bottom: 1px solid var(--color-dark-sand);
	}

	.faq-item summary {
		padding-block: var(--space-grid-gap);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
		cursor: pointer;
		list-style: none;
		font-size: var(--text-card-title);
		color: var(--color-chocolate);
		transition: color var(--duration-fast) var(--ease-calm);
	}

	.faq-item summary:hover {
		color: var(--color-brown);
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	/* The Figma chevron points up (open); it is flipped when the item is closed. */
	.faq-item__icon {
		flex-shrink: 0;
		transform: rotate(180deg);
		transition: transform var(--duration-base) var(--ease-calm);
	}

	.faq-item[open] .faq-item__icon {
		transform: none;
	}

	.faq-item__answer {
		padding-bottom: var(--space-grid-gap);
		line-height: 1.5;
		color: var(--color-brown);
	}

	.contact {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
	}

	.contact__photo {
		aspect-ratio: 331 / 238;
		width: 100%;
		max-width: 20.6875rem;
	}

	.contact__actions {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-grid-gap);
	}

	/* The column is as wide as its longest line (the email); the button fills it, as in Figma. */
	.contact__actions {
		align-self: flex-start;
	}

	.contact__actions .button {
		align-self: stretch;
		gap: var(--space-sm);
	}

	.contact__line {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		min-height: 44px;
		overflow-wrap: anywhere;
		text-decoration: none;
		color: var(--color-chocolate);
	}

	a.contact__line:hover {
		text-decoration: underline;
	}

	a.contact__line:focus-visible {
		outline: 2px solid var(--color-brown);
		outline-offset: 4px;
	}

	@media (min-width: 1280px) {
		.contact {
			flex-direction: row;
			align-items: center;
		}

		.contact__photo {
			flex: 0 0 20.6875rem;
		}

		.contact__actions {
			align-self: center;
			flex-shrink: 0;
		}

		/* Indented to line up under the button label, as in Figma. */
		.contact__line {
			padding-inline: var(--space-grid-gap);
		}
	}
</style>
