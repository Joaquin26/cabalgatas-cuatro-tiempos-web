---
import "../styles/global.css";
import Nav from "../components/layout/Nav.astro";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Experiencias de campo en Pachacámac: caballos, naturaleza y momentos para recordar.",
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<script is:inline>
			document.documentElement.classList.add("has-js");
		</script>
		<title>{title} · Cabalgatas Cuatro Tiempos</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />
		<slot />
		<script>
			const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0.15 },
			);
			for (const el of revealEls) observer.observe(el);

			setTimeout(() => {
				for (const el of revealEls) el.classList.add("is-visible");
				observer.disconnect();
			}, 4000);
		</script>
	</body>
</html>
