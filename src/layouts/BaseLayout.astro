---
import "../styles/global.css";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";
import Lightbox from "../components/ui/Lightbox.astro";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Experiencias de campo en Pachacámac: caballos, naturaleza y momentos para recordar.",
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<script is:inline>
			document.documentElement.classList.add("has-js");
		</script>
		<title>{title} · Cabalgatas Cuatro Tiempos</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Nav />
		<slot />
		<Footer />
		<Lightbox />
		<script>
			const targets = Array.from(document.querySelectorAll<HTMLElement>(".reveal, [data-stagger]"));

			// Children of [data-stagger] get their position, used as the entrance delay.
			for (const el of targets) {
				if (el.hasAttribute("data-stagger")) {
					Array.from(el.children).forEach((child, i) =>
						(child as HTMLElement).style.setProperty("--i", String(i)),
					);
				}
			}

			// Wrap the trailing "→" of buttons and arrow links so it can nudge on hover. The arrow is
			// decorative, so it is hidden from screen readers.
			for (const el of document.querySelectorAll<HTMLElement>(".button, .link-arrow")) {
				const node = Array.from(el.childNodes)
					.reverse()
					.find((n) => n.nodeType === Node.TEXT_NODE && n.textContent?.trim());
				const text = node?.textContent ?? "";
				if (!node || !text.trimEnd().endsWith("→")) continue;
				const arrow = document.createElement("span");
				arrow.className = "arrow-nudge";
				arrow.setAttribute("aria-hidden", "true");
				arrow.textContent = "\u00a0→";
				node.textContent = text.slice(0, text.lastIndexOf("→")).trimEnd();
				node.after(arrow);
			}

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					}
				},
				{ threshold: 0, rootMargin: "0px 0px -10% 0px" },
			);
			for (const el of targets) observer.observe(el);

			// Anything already on screen at load (such as the hero controls, which sit inside the
			// observer's bottom margin) enters right away instead of waiting for a scroll.
			requestAnimationFrame(() => {
				for (const el of targets) {
					const rect = el.getBoundingClientRect();
					if (rect.top < window.innerHeight && rect.bottom > 0) {
						el.classList.add("is-visible");
						observer.unobserve(el);
					}
				}
			});

			// Safety net: if the observer never fires, reveal only what is on screen right now.
			// Elements further down keep waiting, so their entrance still plays on scroll.
			setTimeout(() => {
				for (const el of targets) {
					const rect = el.getBoundingClientRect();
					if (rect.top < window.innerHeight && rect.bottom > 0) {
						el.classList.add("is-visible");
						observer.unobserve(el);
					}
				}
			}, 4000);
		</script>
	</body>
</html>
